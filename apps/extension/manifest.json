{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Sound Stickers",
  "version": "0.1.2",
  "key": "",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://sound-sticker-maker.haythamasalama.me/",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://www.youtube-nocookie.com/*", "https://*.tiktok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_action__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["guard.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube-nocookie.com/embed/*"],
      "js": ["youtube.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["player.html"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["https://sound-sticker-maker.haythamasalama.me/*", "http://localhost/*"]
  }
}
