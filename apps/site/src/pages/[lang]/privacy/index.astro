---
import LegalPage from '../../../components/LegalPage.astro'
import { LANGS, type Lang } from '../../../i18n'

export function getStaticPaths() {
  return LANGS.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }))
}
const lang = Astro.params.lang as Lang
---

<LegalPage lang={lang} />
