{
  "name": "sound-sticker-maker-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server that lets AI assistants make WhatsApp stickers that play sound, from a video, GIF or picture plus any audio.",
  "author": "Haytham A. Salama (https://haythamasalama.me/)",
  "license": "MIT",
  "homepage": "https://haythamasalama.github.io/sound-sticker-maker/ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haythamasalama/sound-sticker-maker.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "stickers",
    "sound stickers",
    "audio stickers",
    "claude"
  ],
  "bin": {
    "sound-sticker-maker-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@sound-sticker-maker/core": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
