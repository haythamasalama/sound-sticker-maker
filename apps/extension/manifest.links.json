{
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.youtube-nocookie.com/*", "https://*.tiktok.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube-nocookie.com/embed/*"],
      "js": ["youtube.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["player.html"], "matches": ["https://web.whatsapp.com/*"] }]
}
