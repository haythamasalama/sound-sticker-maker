---
import { useT, type Lang } from '../i18n'
import Icon from './Icon.astro'
import Sticker from './Sticker.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
---

<div class="chat" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <div class="chat-head">
    <span class="chat-av">{t('mock.chat').slice(0, 1)}</span>
    <span class="chat-who"><b>{t('mock.chat')}</b><span>{t('mock.status')}</span></span>
  </div>
  <div class="chat-body">
    <p class="bub in">{t('mock.msg1')}<time dir="ltr">21:02</time></p>
    <p class="bub out">
      {t('mock.msg2')}<time dir="ltr"
        >21:03<svg class="tick" width="16" height="11" viewBox="0 0 16 11" aria-hidden="true"
          ><path
            d="M11.07.66 4.7 7.04 1.93 4.27.66 5.54 4.7 9.58 12.34 1.93zM14.4.66 8.02 7.04l-.62-.62-1.27 1.27 1.89 1.89 7.64-7.65z"
            fill="currentColor"></path></svg
        ></time
      >
    </p>
    <div class="chat-stk">
      <Sticker word={t('mock.word')} sound />
      <time dir="ltr">21:03</time>
    </div>
  </div>
  <div class="chat-input">
    <span>{t('mock.message')}</span>
    <i><Icon name="send" size={15} /></i>
  </div>
</div>
