{
  "name": "sound-sticker-maker-workspace",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Make WhatsApp stickers that play sound: from a video, a GIF or a picture with any audio, in your browser.",
  "author": "Haytham A. Salama (https://haythamasalama.me/)",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm --filter @sound-sticker-maker/extension build",
    "package": "pnpm --filter @sound-sticker-maker/extension package",
    "site": "pnpm --filter @sound-sticker-maker/site dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "release:version": "node scripts/set-version.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "pnpm": {
    "overrides": {
      "js-beautify>glob": "^14.0.4",
      "editorconfig>minimatch": "^11.0.6"
    }
  }
}
